{
  "name": "n8n-nodes-cashwerk",
  "version": "1.0.0",
  "description": "n8n community node for the cashwerk API – CRM, Invoicing, Projects, Time Tracking and more",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "cashwerk",
    "crm",
    "invoicing",
    "time-tracking",
    "project-management",
    "automation"
  ],
  "license": "MIT",
  "author": {
    "name": "cashwerk",
    "email": "milos@cashwerk.io",
    "url": "https://cashwerk.io"
  },
  "homepage": "https://docs.cashwerk.io/",
  "bugs": {
    "url": "https://github.com/cashwerk/n8n-nodes-cashwerk/issues"
  },
  "main": "dist/nodes/Cashwerk/Cashwerk.node.js",
  "types": "dist/nodes/Cashwerk/Cashwerk.node.d.ts",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "n8n-node prerelease",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "build:watch": "tsc --watch",
    "release": "n8n-node release"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CashwerkApi.credentials.js",
      "dist/credentials/CashwerkOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Cashwerk/Cashwerk.node.js",
      "dist/nodes/Cashwerk/CashwerkTrigger.node.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cashwerk/n8n-nodes-cashwerk.git"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.44.5",
    "eslint": "^9.29.0",
    "n8n-core": "^2.7.2",
    "n8n-workflow": "^2.8.0",
    "prettier": "^3.9.6",
    "release-it": "^20.2.1",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  }
}
