{
  "name": "cashwerk – Deal Won → Auto-Create Project & Task",
  "nodes": [
    {
      "parameters": {
        "events": ["deal.update"]
      },
      "id": "trigger-node",
      "name": "cashwerk Trigger",
      "type": "n8n-nodes-cashwerk.cashwerkTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "REPLACE_ME",
      "credentials": {
        "cashwerkApi": {
          "id": "REPLACE_ME",
          "name": "cashwerk API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.stage }}",
              "operation": "equals",
              "value2": "won"
            }
          ]
        }
      },
      "id": "filter-node",
      "name": "Filter Won Deals",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "authentication": "apiKey",
        "resource": "project",
        "operation": "create",
        "projectName": "=Project: {{ $json.body.name }}",
        "additionalFields": {
          "description": "=Auto-created from won deal \"{{ $json.body.name }}\" (value: {{ $json.body.value }})"
        }
      },
      "id": "create-project",
      "name": "cashwerk – Create Project",
      "type": "n8n-nodes-cashwerk.cashwerk",
      "typeVersion": 1,
      "position": [680, 200],
      "credentials": {
        "cashwerkApi": {
          "id": "REPLACE_ME",
          "name": "cashwerk API Key"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const project = items[0].json;\nconst deal = $node['cashwerk Trigger'].json.body;\n\nconst tasks = [\n  { title: `Kickoff meeting – ${deal.name}`, description: 'Schedule and conduct project kickoff with the client.' },\n  { title: `Scope definition – ${deal.name}`, description: 'Define project scope, milestones, and deliverables.' },\n  { title: `Resource planning – ${deal.name}`, description: 'Assign team members and allocate resources.' },\n];\n\nreturn tasks.map(t => ({ json: { ...t, projectId: project.id || project._id } }));"
      },
      "id": "generate-tasks",
      "name": "Generate Task List",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "authentication": "apiKey",
        "resource": "invoice",
        "operation": "create",
        "contactId": "={{ $node['cashwerk Trigger'].json.body.contactId }}",
        "additionalFields": {
          "title": "=Invoice for {{ $node['cashwerk Trigger'].json.body.name }}"
        }
      },
      "id": "create-invoice",
      "name": "cashwerk – Create Invoice",
      "type": "n8n-nodes-cashwerk.cashwerk",
      "typeVersion": 1,
      "position": [680, 400],
      "credentials": {
        "cashwerkApi": {
          "id": "REPLACE_ME",
          "name": "cashwerk API Key"
        }
      }
    },
    {
      "parameters": {},
      "id": "noop-node",
      "name": "Skip (Not Won)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [680, 520]
    }
  ],
  "connections": {
    "cashwerk Trigger": { "main": [[{ "node": "Filter Won Deals", "type": "main", "index": 0 }]] },
    "Filter Won Deals": {
      "main": [
        [
          { "node": "cashwerk – Create Project", "type": "main", "index": 0 },
          { "node": "cashwerk – Create Invoice", "type": "main", "index": 0 }
        ],
        [{ "node": "Skip (Not Won)", "type": "main", "index": 0 }]
      ]
    },
    "cashwerk – Create Project": { "main": [[{ "node": "Generate Task List", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "templateId": "cashwerk-deal-to-project-pipeline",
    "instanceId": ""
  },
  "tags": [{ "name": "cashwerk" }, { "name": "Sales" }, { "name": "Project Management" }, { "name": "Automation" }]
}
