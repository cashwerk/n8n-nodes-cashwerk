          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.data.completionStatus }}",
              "rightValue": "WON",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-2",
      "name": "Deal Won?",
